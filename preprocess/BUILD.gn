import("//test/xts/tools/build/suite.gni")

action("xts_preprocess") {
  script = "xts_preprocess.sh"
  _log_path = "${target_gen_dir}/xts_preprocess.log"
  outputs = [ _log_path ]
  args = [
    rebase_path("${XTS_ROOT}/${XTS_SUITENAME}", root_build_dir),
    rebase_path(_log_path, root_build_dir),
  ]
}
